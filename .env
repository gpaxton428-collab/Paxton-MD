# ============================================================
#  Paxton MD — Environment Variables
#  Copy this file's values into Render's Environment tab (or your
#  host's env config) — Render does NOT read this file directly,
#  it only reads what you set in its dashboard.
# ============================================================

# Bot display name — shown in the menu header and set as the WhatsApp
# profile name. Can also be changed live with .setbotname.
BOT_NAME=Paxton MD

# Paste your PAXTON-MD:... session string here (from the session
# generator) to skip pairing-code login entirely. Leave blank to use
# interactive pairing-code login instead (only works when running
# locally/VPS with a terminal — not on Render, since Render has no
# interactive console).
#
# On panels that don't support custom environment variables at all
# (Katabump, bot-hosting.net, and most free Pterodactyl-style panels),
# skip this and paste your session string into session_id.txt in the
# project root instead — same effect, no env var needed.
SESSION_ID=

# Command prefix. Defaults to "." if not set.
PREFIX=.

# Port the main bot's web server binds to. Render sets its own PORT
# automatically and that always takes priority — this is only used
# when running locally.
PORT=3000

# Port for the standalone session generator (session-generator/index.js)
# when run locally alongside the main bot. Same deal — Render's PORT
# env var wins when deployed there.
SESSION_GEN_PORT=4000

# Auto-login on boot without prompting (used by some host panels).
# Leave unset unless your panel/host requires it.
# AUTO_LOGIN=true

# Chatbot auto-reply (.env only — no toggle command needed, it just turns
# on once a key is set). Replies in DMs always, and in groups only when
# the bot is @mentioned or replied to. Set ONE of these — Anthropic is
# checked first if both are set:
# ANTHROPIC_API_KEY=sk-ant-...   (https://console.anthropic.com)
# OPENAI_API_KEY=sk-...          (https://platform.openai.com)

# Set automatically by some hosting panels to flag "this is a managed
# panel deployment" — only affects a platform label shown in .ping /
# status commands. You normally don't need to set this yourself.
# PANEL=true
