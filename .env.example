# ============================================================
#  Paxton Tech — Environment Variables (EXAMPLE / TEMPLATE)
#  Copy this file to .env and fill in your own values.
#  NEVER commit your actual .env — it's already in .gitignore.
#  This example file has no real secrets, so it's safe to commit
#  and push to GitHub without triggering secret-scanning alerts.
# ============================================================

# Bot display name — shown in the menu header and set as the WhatsApp
# profile name. Can also be changed live with .setbotname.
BOT_NAME=Paxton Tech

# Paste your PAXTON-TECH:... session string here (from the session
# generator) to skip pairing-code login entirely. Leave blank to use
# interactive pairing-code login instead (only works when running
# locally/VPS with a terminal).
SESSION_ID=

# Bootstraps owner.json on first boot if it does not exist yet.
OWNER_NUMBER=27797352930

# Command prefix. Defaults to "." if not set.
PREFIX=.

# Port the main bot's web server binds to, if it runs one. Render/most
# hosts set their own PORT automatically and that always takes priority.
PORT=3000

# Port for the standalone session generator (session-generator/index.js)
# when run locally alongside the main bot.
SESSION_GEN_PORT=4000

# Auto-login on boot without prompting (used by some host panels).
# Leave unset unless your panel/host requires it.
# AUTO_LOGIN=true

# Your own WhatsApp community group invite link, if you want the
# auto-join-on-owner-link feature. Leave unset to keep it disabled.
# GROUP_LINK=https://chat.whatsapp.com/your-invite-code

# Your own git repo URL, used by the .update command to pull the latest
# code. Leave unset if you don't use .update.
# GITHUB_REPO_URL=https://github.com/your-username/your-repo.git

# Chatbot auto-reply (.env only — no toggle command needed, it just turns
# on once a key is set). Replies in DMs always, and in groups only when
# the bot is @mentioned or replied to. Set ONE of these — Anthropic is
# checked first if both are set. Neither key is included here — get your
# own from the provider, never paste a real key into a file you commit:
# ANTHROPIC_API_KEY=sk-ant-...   (https://console.anthropic.com)
# OPENAI_API_KEY=sk-...          (https://platform.openai.com)
