# Some free hosting panels (bot-hosting.net, Katabump, etc.) have slow or
# flaky outbound network access, which shows up as "failed to fetch"
# during npm install on larger packages like @whiskeysockets/baileys.
# These settings give npm more patience before giving up.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
